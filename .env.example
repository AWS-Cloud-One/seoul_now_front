# Browser settings: these values are public and included at build time.
VITE_API_BASE_URL=/api/v1
VITE_KAKAO_MAP_APP_KEY=

# Vite dev/preview proxy only. Keep the /api/v1 path in browser requests.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional Docker settings. Windows/macOS: host.docker.internal reaches the host.
FRONTEND_PORT=5173
DOCKER_API_PROXY_TARGET=http://host.docker.internal:8000
