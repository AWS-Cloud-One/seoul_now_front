# Browser settings: these values are public and included at build time.
VITE_API_BASE_URL=/api/v1
VITE_KAKAO_MAP_APP_KEY=

# Chat is the default recommendation experience.
# Set mock only for screen development without the backend; real is the default.
VITE_CHAT_MODE=real
VITE_CHAT_BASE_URL=/api/v2/chat

# Vite dev/preview proxy only. Keep the /api/v1 path in browser requests.
API_PROXY_TARGET=http://127.0.0.1:8000
# Local V2 chat app (uvicorn app.modules.chat_v2.api:create_app --factory --port 8001).
CHAT_PROXY_TARGET=http://127.0.0.1:8001

# Local Vite dev/preview port.
FRONTEND_PORT=5173
